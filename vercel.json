{
  "buildCommand": "cd \"mca project/frontend\" && npm install && npm run build",
  "outputDirectory": "mca project/frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://shareabite-backend.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
